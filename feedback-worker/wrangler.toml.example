# Copy this to wrangler.toml, set the D1 database_id and deploy manually.
# This Worker is separate from the DNS-only GitHub Pages website.
name = "homefunds-feedback-api"
main = "src/index.js"
compatibility_date = "2026-11-19"
workers_dev = true

[vars]
SITE_ORIGIN = "https://homefunds.signiswellfire.com"
TURNSTILE_HOSTNAME = "homefunds.signiswellfire.com"

[[d1_databases]]
binding = "DB"
database_name = "homefunds-feedback"
database_id = "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"

[triggers]
crons = ["0 1 * * *"]
